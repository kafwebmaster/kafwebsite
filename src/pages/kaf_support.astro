---
import HeaderSub from '../components/HeaderSub.astro';
import Menubar from '../components/Menubar.astro';
import Footer from '../components/Footer.astro';
import { getSiteData } from '../lib/content.js';
const data = await getSiteData();
---
<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="UTF-8">
    <title>協賛・応援【KADOMA ART FES - 門真のまちをアートで染めよう】</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="大和田・古川橋駅前で行われる門真最大級アートイベントKADOMA ART FES">
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="css/sub-page.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.10.0/css/lightbox.min.css">
    <style is:inline>
.gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 5px; /* ギャップを調整 */
}
.gallery img {
    width: 100%;
    height: auto;
}
.gallery-item {
    width: calc(16.666% - 5px); /* ギャップを考慮した6列レイアウト */
    margin-bottom: 5px;
    position: relative;
}
.gallery-item img {
    object-fit: cover; /* 画像をコンテナに合わせてトリミング */
    width: 100%;
    height: 100%;
    aspect-ratio: 1 / 1; /* 正方形のアスペクト比を設定 */
}
@media (max-width: 1200px) {
    .gallery-item {
        width: calc(25% - 5px); /* 中程度の画面では4列レイアウト */
    }
}
@media (max-width: 768px) {
    .gallery-item {
        width: calc(33.333% - 5px); /* スマホでは3列レイアウト */
    }
}
@media (max-width: 480px) {
    .gallery-item {
        width: calc(50% - 5px); /* 小さな画面では2列レイアウト */
    }
}

    .logo-container {
        text-align: center; /* 画像をセンターに寄せるために追加 */
    }
    .logo-container img {
        max-width: 70%; /* 画像の最大幅を70%に設定 */
        height: auto; /* 高さは自動調整 */
        display: block; /* 画像をブロック要素として扱い、センタリングするために追加 */
        margin: 0 auto; /* 左右のマージンを自動で設定してセンターに寄せる */
    }


	.kaf-event-details {
	    background-color: #fff; /* 背景を白くする */
	    padding: 20px; /* 内側の余白を追加 */
	    border-radius: 8px; /* 角を丸くする */
	    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); /* 影を追加 */
	    color: #000; /* 文字の色を黒にする */
	}
	.kaf-event-details .kaf-section-title, .kaf-event-details .kaf-sub-section-title {
	    font-size: 1.5em;
	    font-weight: bold;
	    margin-top: 20px;
	    margin-bottom: 10px;
	}
	.kaf-event-details table {
	    width: 100%;
	    border-collapse: collapse;
	    margin-bottom: 20px;
	}
	.kaf-event-details th, .kaf-event-details td {
	    padding: 10px;
	    text-align: left;
	    border-bottom: 1px solid #ddd;
	}
	.kaf-event-details th {
	    background-color: #f2f2f2;
	    color: #000; /* 文字の色を黒にする */
	}
	.kaf-event-details ul {
	    list-style-type: none;
	    padding: 0;
	}
	.kaf-event-details li {
	    padding: 10px;
	    border-bottom: 1px solid #ddd;
	    color: #000; /* 文字の色を黒にする */
	}
        @media (min-width: 1200px) {
            .container {
                margin: 0 15%; /* 左右に15％のマージンを追加 */
            }
        }


        .table-container {
            overflow-x: auto; /* 横スクロールを有効にする */
            margin-bottom: 20px; /* テーブル間にスペースを追加 */
        }
        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 600px; /* 最小幅を設定して、スマホで横スクロールを強制 */
        }
        th, td {
            border: 1px solid #f2f2f2; /* ここで枠線の色を設定 */
            padding: 8px;
            text-align: left;
            white-space: nowrap; /* セル内のテキストを折り返さないようにする */
        }
        th {
            background-color: #f2f2f2;
        }


a[href^="mailto:"] {
    color: #0000EE; /* 濃い青色に設定 */
    font-weight: bold; /* 太字に設定 */
    text-decoration: underline; /* 下線を追加 */
}

a[href^="mailto:"]:hover {
    color: #FF0000; /* ホバー時に赤色に変更 */
    text-decoration: none; /* ホバー時に下線を消す */
}
    </style>
</head>
<body class="home">
    <div id="container">

