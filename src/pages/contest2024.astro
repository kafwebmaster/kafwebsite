    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="css/sub-page.css">
 <style is:inline>
        body {
            font-family: Arial, sans-serif;
        }

        h2 {
            text-align: center;
            margin-top: 30px;
        }

        .award-entry {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            margin-bottom: 40px;
        }

        .award-entry img {
            width: 100%;
            max-width: 300px; /* 画像の最大幅を指定 */
            height: auto;
            border-radius: 8px; /* 画像の角を丸める（オプション） */
            display: block;
            margin-bottom: 15px; /* 画像とテキストの間にスペースを追加 */
        }

        .award-entry p {
            font-size: 1rem;
            line-height: 1.4; /* 行間を広くして読みやすくする */
            margin: 0 20px; /* 余白を追加して、テキストが画面の端に寄らないようにする */
        }

        @media (max-width: 767px) {
            .award-entry {
                width: 100%;
            }

            .award-entry img {
                max-width: 100%; /* モバイルでは画像の幅を100%にする */
            }

            .award-entry p {
                font-size: 0.9rem;
                margin-top: 10px; /* 画像との間に余白を追加 */
                line-height: 1.5; /* 行間を少し広くする */
            }
        }

    .left-align p {
        text-align: left;
        line-height: 1.1; /* 行間を狭くする */
	 margin: 7px 0; /* マージンを狭くする */
    }

    .profile-section img {
        display: block;
        margin: 20px auto; /* 画像の上下と中央にマージンを追加 */
    }
    .profile-section h3 {
        margin-top: 20px; /* h3の上部にマージンを追加 */
        margin-bottom: 10px; /* h3の下部にマージンを追加 */
    }
.profile-section p {
        margin-top: 10px; /* pタグの上部にマージンを追加 */
        margin-bottom: 10px; /* pタグの下部にマージンを追加 */
    }


	.kaf-event-details {
	    background-color: #fff; /* 背景を白くする */
	    padding: 20px; /* 内側の余白を追加 */
	    border-radius: 8px; /* 角を丸くする */
	    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); /* 影を追加 */
	    color: #000; /* 文字の色を黒にする */
	}
	.kaf-event-details .kaf-section-title, .kaf-event-details .kaf-sub-section-title {
	    font-size: 1.5em;
	    font-weight: bold;
	    margin-top: 20px;
	    margin-bottom: 10px;
	}
	.kaf-event-details table {
	    width: 100%;
	    border-collapse: collapse;
	    margin-bottom: 20px;
	}
	.kaf-event-details th, .kaf-event-details td {
	    padding: 10px;
	    text-align: left;
	    border-bottom: 1px solid #ddd;
	}
	.kaf-event-details th {
	    background-color: #f2f2f2;
	    color: #000; /* 文字の色を黒にする */
	}
	.kaf-event-details ul {
	    list-style-type: none;
	    padding: 0;
	}
	.kaf-event-details li {
	    padding: 10px;
	    border-bottom: 1px solid #ddd;
	    color: #000; /* 文字の色を黒にする */
	}


    </style>

