---
// 開閉メニュー (旧 includeHTML/menubar.html)
// 旧 include.js は <div id="include-menubar"> の中身としてこの内容を挿入していた。
// main.js が #include-menubar を開閉対象にしているため、wrapper div ごと出力して
// DOM 構造を現行と一致させる。
// 年度依存値はビルド時に差し込む (data-field 属性は対応関係の記録として残置)。
//
// base プロパティ: ルート直下のページは未指定 (= "" で従来どおりの相対パス)。
// /archive/ 配下のページは base="/" を渡し、ルート絶対パスで解決させる。
//
// ギャラリー枠とアーカイブ項目 (docs/archive-feature-design.md 4-1):
// - アーカイブ (editions-archive) が 0 件の間は現行どおり
//   site-settings の gallery.latestPage / latestLabel を表示 (休眠状態。
//   このときの出力は従来とバイト単位で一致させる)
// - 1 件以上あれば、ギャラリー枠が最新大会の詳細ページ (/archive/{slug}.html、
//   slug は大会番号 "kaf5" など) に切り替わる
//   (この場合は生成リンクであり、旧 data-*-field の記録属性は付けない)
// - 「アーカイブ」項目は、最新大会を除く大会 (イベント風景 or コンテスト受賞作品のどちらかがある)
//   が 1 件以上あるときに出す (getArchiveIndex)。コンテスト受賞作品ページは
//   このアーカイブ一覧からのみ辿る (専用メニュー項目は KAF6 対応時に廃止)
import { getArchiveIndex } from '../lib/content.js';
const { data, base = '' } = Astro.props;
const { latest, past } = await getArchiveIndex();
---
<div id="include-menubar">
<style is:inline>
/* アーカイブのサブメニュー (大会 → コンテスト受賞作品 / イベント風景 を画像付きで選ぶ)。
   style.css は変更禁止のため、メニュー内に限定したスタイルをここに置く。
   開閉は <details> のみで行い、main.js には手を入れない。 */
#include-menubar .archive-menu summary { display: block; padding: 10px; cursor: pointer; list-style: none; }
#include-menubar .archive-menu summary::-webkit-details-marker { display: none; }
#include-menubar .archive-menu > details > summary::after { content: " ▾"; font-size: 0.8em; }
#include-menubar .archive-menu > details[open] > summary::after { content: " ▴"; }
#include-menubar .archive-editions { margin: 0 auto 10px; max-width: 760px; border-top: 1px solid rgba(255,255,255,0.25); }
#include-menubar .archive-editions > li { border-bottom: 1px solid rgba(255,255,255,0.25); }
#include-menubar .archive-editions summary { font-size: 0.95em; }
#include-menubar .archive-editions summary::before { content: "＋ "; opacity: 0.7; }
#include-menubar .archive-editions details[open] > summary::before { content: "－ "; }
#include-menubar .archive-edition-year { display: inline-block; min-width: 3.2em; margin-right: 0.5em; font-weight: bold; color: var(--primary-color, #d05a4a); }
#include-menubar .archive-tiles { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; padding: 4px 10px 16px; }
#include-menubar .archive-tile { width: 180px; max-width: 42vw; padding: 0; color: inherit; }
#include-menubar .archive-tile img, #include-menubar .archive-tile-noimg { display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 6px; background: rgba(255,255,255,0.12); }
#include-menubar .archive-tile-label { display: block; margin-top: 6px; font-size: 0.85em; line-height: 1.3; }
#include-menubar .archive-tile:hover img { opacity: 0.8; }
#include-menubar .archive-menu-all { font-size: 0.85em; opacity: 0.85; }
</style>
<nav>
    <ul>
        <li><a href={`${base}index.html`}>HOME</a></li>
        <li><a href={`${base}kaf_info.html`}>KAFとは</a></li>
        <li><a href={`${base}kaf_mmg.html`}>イベント開催情報</a></li>
        <li><a href={`${base}media.html`}>メディア掲載情報</a></li>
        <li><a href={`${base}contest_entry.html`}>KAFコンテスト作品募集(<span data-field="contest.statusLabel">{data.contest.statusLabel}</span>)</a></li>
        {latest ? <li><a href={`${base}archive/${latest.slug}.html`}>{latest.shortName}イベント風景Photoギャラリー</a></li> : <li><a href={`${base}${data.gallery.latestPage}`} data-href-field="gallery.latestPage" data-field="gallery.latestLabel">{data.gallery.latestLabel}</a></li>}
        {past.length > 0 && <li class="archive-menu">
            <details>
                <summary>アーカイブ</summary>
                <ul class="archive-editions">
{past.map((e) => (
                    <li>
                        <details>
                            <summary><span class="archive-edition-year">{e.year}</span>{e.title}</summary>
                            <div class="archive-tiles">
                                {e.contest && <a class="archive-tile" href={`${base}${e.contest.page.replace(/^\//, '')}`}>
                                    {e.contest.thumb ? <img src={e.contest.thumb} alt="" loading="lazy"> : <span class="archive-tile-noimg"></span>}
                                    <span class="archive-tile-label">コンテスト受賞作品</span>
                                </a>}
                                {e.event && <a class="archive-tile" href={`${base}archive/${e.event.slug}.html`}>
                                    {(e.event.heroImage || e.event.gallery[0]) ? <img src={e.event.heroImage || e.event.gallery[0]} alt="" loading="lazy"> : <span class="archive-tile-noimg"></span>}
                                    <span class="archive-tile-label">イベント風景Photoギャラリー</span>
                                </a>}
                            </div>
                        </details>
                    </li>
))}
                    <li><a class="archive-menu-all" href={`${base}archive.html`}>アーカイブ一覧ページへ</a></li>
                </ul>
            </details>
        </li>}
        <li><a href={`${base}kaf_support.html`}>協賛・応援について</a></li>
    </ul>
</nav>

<ul class="icons">
<!--
    <li><a href="#"><img src="images/logo-x.svg" alt="X"></a></li>
    <li><a href="#"><i class="fab fa-line"></i></a></li>
-->
    <li><a href={data.social.youtube} data-href-field="social.youtube"><i class="fab fa-youtube"></i></a></li>
    <li><a href={data.social.instagram} data-href-field="social.instagram"><i class="fab fa-instagram"></i></a></li>
</ul>
</div>
